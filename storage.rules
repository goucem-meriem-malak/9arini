rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /classes/{classId}/{postId}/{fileName} {
      function classPath() { return /databases/(default)/documents/classes/$(classId); }
      function memberPath() { return /databases/(default)/documents/classes/$(classId)/members/$(request.auth.uid); }
      function isTutor() { return request.auth != null && firestore.get(classPath()).data.tutorId == request.auth.uid; }
      function isApproved() { return request.auth != null && firestore.exists(memberPath()) && firestore.get(memberPath()).data.status == 'approved'; }

      allow read: if isTutor() || isApproved();
      allow create: if isTutor()
        && request.auth.token.email_verified == true
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/png|image/jpeg|text/plain|application/vnd\\.openxmlformats-officedocument\\..*');
      allow delete: if isTutor();
      allow update: if false;
    }
  }
}
